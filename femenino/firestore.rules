rules_version = '2';
// App de seguimiento de jugadoras · reglas de acceso
// Lista de administración: el código de usuario de la Dirección Técnica (sale en la app al entrar por primera vez).
// Solo la DT ve los datos de todas; cada jugadora ve y borra los suyos.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid in ['qWzNUUHZWuYVqne7xqAidYRrCtN2']; }
    function acc() { return get(/databases/$(database)/documents/acceso/$(request.auth.uid)).data; }
    function activa() { return signedIn() && exists(/databases/$(database)/documents/acceso/$(request.auth.uid)) && acc().activa == true; }

    // Ficha de alta de cada jugadora (nombre, equipo, aceptación de la información)
    match /jugadoras/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
    // Acceso: solo la DT activa una cuenta, cuando tiene el consentimiento firmado
    match /acceso/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }
    // Objetivos y pregunta de la semana de cada equipo
    match /equipos/{eq} {
      allow read: if isAdmin() || (activa() && acc().equipo == eq);
      allow write: if isAdmin();
    }
    // Lo que responde cada jugadora
    match /registros/{uid}/{rest=**} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if activa() && request.auth.uid == uid;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
    // El reto (minijuego): ficha de juego de cada una (nombre de pila, personaje, puntos del juego, monedas).
    // La ven todas las jugadoras activas y la DT; cada una escribe la suya. Nada de bienestar.
    function enElReto() { return activa() || isAdmin(); }
    match /juego/{uid} {
      allow read: if enElReto();
      allow create, update: if enElReto() && request.auth.uid == uid;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
    // Duelos 1 contra 1: a reta a b. Los ven todas; los crea quien reta y los actualizan las dos.
    match /duelos/{id} {
      allow read: if enElReto();
      allow create: if enElReto() && request.resource.data.a == request.auth.uid;
      allow update: if enElReto() && (request.auth.uid == resource.data.a || request.auth.uid == resource.data.b)
        && request.resource.data.a == resource.data.a && request.resource.data.b == resource.data.b && request.resource.data.seed == resource.data.seed;
      allow delete: if isAdmin() || (signedIn() && (request.auth.uid == resource.data.a || request.auth.uid == resource.data.b));
    }
    // Lo que valora la DT de cada jugadora: solo la DT
    match /valoraciones/{uid}/{rest=**} {
      allow read, write: if isAdmin();
    }
  }
}
